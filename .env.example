# Copy this file to `.env` (never commit `.env`) and fill in the values.
# `just` loads it automatically. In GitHub Actions use repository *variables*
# (Settings > Secrets and variables > Actions > Variables), not secrets:
# the sheet is readable by anyone with the link, so the ID is configuration.

# Google Sheet ID: the long string in the sheet URL
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPAICOM_SHEET_ID=

# GID of each tab: the number after `gid=` in the URL when the tab is open
SPAICOM_PEOPLE_GID=0
SPAICOM_PUBLICATIONS_GID=

# Optional: your contact email for Crossref's faster "polite" API pool.
# Leave empty if you prefer not to share one.
CROSSREF_MAILTO=
